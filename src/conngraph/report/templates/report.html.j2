{% extends "base.html.j2" %}
{% block content %}
<h2 id="Summary">Summary</h2>
<div class="summary-grid">
  {%- for column in summary %}
  <table>{% for key, value in column %}<tr><th>{{ key }}</th><td>{{ value }}</td></tr>{% endfor %}</table>
  {%- endfor %}
</div>
{% if overview %}<div class="overview">{{ overview }}</div>{% endif %}
<div class="call">
  <div class="call-title">{{ call_title }} <button type="button" class="copy">Copy</button></div>
  <pre>{{ call }}</pre>
</div>

{%- set figure = namespace(n=0) %}
{% for section in body %}
<h2 id="{{ section.id }}">{{ section.title }}</h2>
{% if section.desc %}<p class="desc">{{ section.desc }}</p>{% endif %}
{% for step in section.steps %}
{#- a step holding a figure gets its description as a numbered caption below it #}
{%- set captioned = step.desc and ('plotly-graph-div' in step.html or 'class="figure"' in step.html) %}
{%- if captioned %}{% set figure.n = figure.n + 1 %}{% endif %}
<section class="step">
  <h3 class="step-title">{{ step.title }}{% if step.hint %} <span class="hint">{{ step.hint }}</span>{% endif %}</h3>
  {% if step.desc and not captioned %}<p class="desc">{{ step.desc }}</p>{% endif %}
  {{ step.html }}
  {% if captioned %}<p class="caption"><b>Figure {{ figure.n }}.</b> {{ step.desc }}</p>{% endif %}
  {% if step.data %}<p class="data">Data: {% for href in step.data %}<a href="{{ href|e }}">{{ href|e }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}
</section>
{% endfor %}
{% endfor %}
{% endblock %}
